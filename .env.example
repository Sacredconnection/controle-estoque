# Credenciais criadas no Intuit Developer Portal
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# Para testes com Sandbox:
QBO_ENVIRONMENT=sandbox
QBO_REDIRECT_URI=http://localhost:8000/oauth/callback

# Para empresas reais, altere para production e use uma URL HTTPS pública
# já cadastrada exatamente igual no painel da Intuit.
# QBO_ENVIRONMENT=production
# QBO_REDIRECT_URI=https://seu-dominio.com/oauth/callback

# Pode ser deixado como 75; altere somente se a Intuit orientar.
QBO_MINOR_VERSION=75

COMPANY_A_LABEL=Empresa A
COMPANY_B_LABEL=Empresa B

# Informações públicas exibidas nos termos e na política de privacidade.
# Confirme o nome empresarial e o contato antes de publicar o aplicativo.
LEGAL_BUSINESS_NAME=Sacred Connection
LEGAL_CONTACT_EMAIL=info@sacredconnection.co
LEGAL_COUNTRY=Brasil

# Recomendado quando o painel estiver exposto à internet.
# Se ficar vazio, não haverá tela de senha.
APP_PASSWORD=

HOST=127.0.0.1
PORT=8000
DEBUG=false
OPEN_BROWSER=true
